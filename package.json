{
	"name": "@wals-pro/n8n-nodes-weclapp",
	"version": "1.0.2",
	"publishConfig": {
		"access": "public"
	},
	"description": "n8n community node for the weclapp ERP API — CRUD, actions, binary downloads, webhook trigger",
	"license": "MIT",
	"homepage": "https://github.com/Wals-pro/n8n-nodes-weclapp#readme",
	"funding": {
		"type": "homepage",
		"url": "https://wals.pro"
	},
	"keywords": [
		"n8n-community-node-package",
		"weclapp",
		"erp",
		"crm",
		"invoicing",
		"inventory",
		"sales-order",
		"warehouse"
	],
	"author": {
		"name": "Markus Wals",
		"email": "markus@wals.pro",
		"url": "https://wals.pro"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Wals-pro/n8n-nodes-weclapp.git"
	},
	"bugs": {
		"url": "https://github.com/Wals-pro/n8n-nodes-weclapp/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"codegen": "tsx scripts/vendor-sdk-metadata.ts && tsx scripts/generate-descriptors.ts",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node prerelease",
		"release": "n8n-node release",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/WeclappApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Weclapp/Weclapp.node.js",
			"dist/nodes/WeclappTrigger/WeclappTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.58.6",
		"@stoplight/prism-cli": "^5.16.0",
		"@types/node": "^22.20.7",
		"@weclapp/sdk": "2.0.0-dev.35",
		"eslint": "9.39.5",
		"prettier": "3.10.1",
		"release-it": "21.1.3",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"vitest": "^4.1.12"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
